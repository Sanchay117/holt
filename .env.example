# Copy to .env and fill in. Never commit .env, and never paste keys into chats or issues.

# --- Otari (https://otari.ai) ------------------------------------------------
# A workspace API key. For per-user budgets, make it a *service key*:
# dashboard -> API Keys -> Create key -> Advanced -> "Service key" + an end-user budget.
OTARI_API_KEY=
OTARI_BASE_URL=https://api.otari.ai/api/v1
# EU accounts: OTARI_BASE_URL=https://eu.api.otari.ai/api/v1

# No key? Holt runs against a built-in mock gateway so you can explore the UI.
# HOLT_MOCK=1

# --- Models: one open-weight model (or routing policy) per role ---------------
# Run `holt doctor` to check each one resolves on your workspace.
HOLT_SCOUT_MODEL=deepseek/deepseek-v4.1-flash
HOLT_RESEARCHER_MODEL=z-ai/glm-5.3
HOLT_ANALYST_MODEL=deepseek/deepseek-v4-pro-0813
# A routing policy you create in Otari (Routing -> Policies). See docs/OTARI_SETUP.md.
HOLT_WRITER_MODEL=holt-writer
# Optional: a second policy whose primary is broken on purpose, to show a fallback live.
# HOLT_CHAOS_WRITER_MODEL=holt-writer-drill

# --- Guardrails ------------------------------------------------------------------
HOLT_GUARDRAIL_PROFILE=prompt-injection
# If the guardrail can't run: "monitor" serves the request unchecked, "block" refuses it.
HOLT_GUARDRAIL_ON_UNAVAILABLE=monitor

# --- Per-user budgets -------------------------------------------------------------
# Budget id a *new* maintainer starts on (must be on the service key's list). Optional.
# HOLT_END_USER_BUDGET=

# --- Tools ----------------------------------------------------------------------
HOLT_DEEPWIKI_MCP=1
# Comma-separated ids of MCP servers stored in your Otari workspace (Tools -> MCP servers).
# HOLT_MCP_SERVER_IDS=
HOLT_MAX_TOOL_ITERATIONS=6
HOLT_RUN_ISSUE_SNIPPETS=1
HOLT_DUPLICATE_CANDIDATES=40

# --- GitHub (optional) -------------------------------------------------------------
# Raises the API rate limit and lets you post the drafted reply. Fine-grained token,
# "Issues: read and write" on the repos you maintain.
# GITHUB_TOKEN=
